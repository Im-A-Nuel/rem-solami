# Solami. Dashboard > API Keys.
# Put your key in SOLAMI_API_KEY and Rem builds the gRPC token and the RPC and landing URLs from it.
# Fill one of the variables below only to override it, for example SOLAMI_SWQOS_KEY for a separate landing key.
# (solami.fast and solami.dev point at the same servers.)
SOLAMI_API_KEY=
SOLAMI_SWQOS_KEY=
SOLAMI_GRPC_ENDPOINT=grpc.solami.fast:443
SOLAMI_GRPC_TOKEN=
SOLAMI_RPC_URL=
SOLAMI_BEAM_URL=
SOLAMI_MIRAGE_WS=

# Fallback RPC for parallel send and devnet testing
FALLBACK_RPC_URL=https://api.devnet.solana.com

# Rem
REM_FEE_PAYER_KEYPAIR=./keys/fee-payer.json
# Neon: use the POOLED connection string. Never commit it or paste it into chat.
DATABASE_URL=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
